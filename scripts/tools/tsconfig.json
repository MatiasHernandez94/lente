{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["../../src/*"],
      "server-only": ["./server-only.ts"]
    }
  },
  "include": ["**/*.ts", "../../src/**/*.ts"]
}
