# Clave utilizada para firmar la sesión de usuario (jose HS256)
# Genere una con: openssl rand -base64 32
SESSION_SECRET=

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Cadena de conexión Postgres (pooler o directa), usada para migraciones.
DATABASE_URL=

# Opcional: si se ejecuta el pipeline pesado de seguimiento (ONNX/ffmpeg) localmente con LENTE_RUN_SCOUT_LOCAL=1
# LENTE_RUN_SCOUT_LOCAL=0

# Opcional (scout local + YouTube): ruta al binario de yt-dlp si no está en el PATH.
# YT_DLP_PATH=/ruta/a/yt-dlp

# Opcional (scout local): límites para desarrollo/pruebas.
#   LENTE_SCOUT_MAX_FRAMES - máximo de frames a analizar (0 = sin límite)
#   LENTE_SCOUT_MAX_SECONDS - máximo de segundos a descargar de YouTube (0 = video completo)
# LENTE_SCOUT_MAX_FRAMES=0
# LENTE_SCOUT_MAX_SECONDS=0
