# Supabase Auth (Project Settings -> API)
# Copie estos valores a .env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: solo servidor (repo, storage). Nunca exponer al cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión Postgres (pooler o directa), usada para migraciones.
DATABASE_URL=

# URL pública de la app (para links en emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clave de Gemini. Obligatoria para detectar deporte, mejoras, informe de coach
# y OKRs. Si falta, los jobs fallan con kind "no_keys" (no se reintenta).
GEMINI_API_KEY=

# Cola de procesamiento: "1" encola en processing_jobs y un worker externo los
# toma (producción). Vacío = se procesa en línea en la request (desarrollo).
LENTE_PROCESSOR_QUEUE=

# ── Alertas operativas (Telegram) ────────────────────────────────────────────
# Bot creado con @BotFather (/newbot). El token es un secreto: nunca va al repo.
# TELEGRAM_BOT_TOKEN=
# Chat de destino: https://api.telegram.org/bot<TOKEN>/getUpdates -> message.chat.id
# TELEGRAM_CHAT_ID=

# ── Cron de salud (/api/cron/health) ─────────────────────────────────────────
# Secreto que exige el endpoint; si falta responde 503. Vercel Cron lo manda
# automáticamente como "Authorization: Bearer $CRON_SECRET" si está seteado.
# CRON_SECRET=

# Opcional: si se ejecuta el pipeline pesado de seguimiento (ONNX/ffmpeg) localmente con LENTE_RUN_SCOUT_LOCAL=1
# LENTE_RUN_SCOUT_LOCAL=0

# Opcional (scout local + YouTube): ruta al binario de yt-dlp si no está en el PATH.
# YT_DLP_PATH=/ruta/a/yt-dlp

# Opcional (scout local): límites para desarrollo/pruebas.
#   LENTE_SCOUT_MAX_FRAMES - máximo de frames a analizar (0 = sin límite)
#   LENTE_SCOUT_MAX_SECONDS - máximo de segundos a descargar de YouTube (0 = video completo)
# LENTE_SCOUT_MAX_FRAMES=0
# LENTE_SCOUT_MAX_SECONDS=0
